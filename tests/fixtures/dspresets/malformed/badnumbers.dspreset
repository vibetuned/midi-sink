<?xml version="1.0"?>
<DecentSampler minVersion="banana">
  <groups attack="-5" decay="nan" sustain="1e309" release="abc" volume="loud" seqMode="sideways">
    <group>
      <sample path="../minimal/Samples/tone.wav" rootNote="-5" loNote="abc" hiNote="999" loVel="127" hiVel="0" tuning="inf" start="-1" end="99999999999" loopStart="9e99"/>
      <sample path="" rootNote="60"/>
