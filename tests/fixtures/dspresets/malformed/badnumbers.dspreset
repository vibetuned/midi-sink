    <effects><effect frequency="-1"/><effect type="reverb" wetLevel="1e40"/></effects>
  </groups>
  <ui><labeled-knob minValue="1" maxValue="0" value="7"><binding type="effect" translation="table" translationTable="garbage;;1,,2;x,y"/></labeled-knob></ui>
