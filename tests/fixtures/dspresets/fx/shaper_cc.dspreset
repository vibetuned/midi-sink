<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 89: the bus shaper with the drive on CC 20 (FX_DRIVE 1..100) and the level on CC 21 (FX_OUTPUT_LEVEL). -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group>
      <sample path="Samples/saw110.wav" rootNote="45" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
  <effects>
    <effect type="wave_shaper" drive="1" driveBoost="0" outputLevel="0.4"/>
  </effects>
  <midi>
    <cc number="20"><binding type="effect" level="instrument" position="0" parameter="FX_DRIVE" translation="linear" translationOutputMin="1" translationOutputMax="100"/></cc>
    <cc number="21"><binding type="effect" level="instrument" position="0" parameter="FX_OUTPUT_LEVEL"/></cc>
  </midi>
</DecentSampler>
