<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 89: an envelope with no filter binding (AMP_VOLUME): plays through, raises no note — the modulators sentence names LFOs and sequences now. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group>
      <sample path="Samples/saw110.wav" rootNote="45" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
  <modulators>
    <envelope attack="0.1" decay="0.3" sustain="0.5" release="0.2"><binding type="amp" level="instrument" parameter="AMP_VOLUME"/></envelope>
  </modulators>
</DecentSampler>
