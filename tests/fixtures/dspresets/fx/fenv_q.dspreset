<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 89: the envelope on the Q (FX_FILTER_Q, set 0.7..5): the resonance rings at the start and settles. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.5" ampVelTrack="0">
    <group>
      <sample path="Samples/saw110.wav" rootNote="45" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
      <effects>
        <effect type="lowpass" frequency="1000" resonance="0.7"/>
      </effects>
    </group>
  </groups>
  <modulators>
    <envelope attack="0.0" decay="0.5" sustain="0" release="0.1" modAmount="1">
      <binding type="effect" level="group" groupIndex="0" effectIndex="0" parameter="FX_FILTER_Q" translation="linear" translationOutputMin="0.7" translationOutputMax="5" modBehavior="set"/>
    </envelope>
  </modulators>
</DecentSampler>
