<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 89: three stages in their listed order, one disabled between them, the peak's gain on CC 20 (FX_FILTER_GAIN at position 2). -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group>
      <sample path="Samples/saw110.wav" rootNote="45" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
  <effects>
    <effect type="low_shelf" frequency="200" gain="6" gainUnit="decibels"/>
    <effect type="peak" frequency="3000" Q="1" gain="12" gainUnit="decibels" enabled="false"/>
    <effect type="peak" frequency="1000" Q="1" gain="6" gainUnit="decibels"/>
    <effect type="high_shelf" frequency="2000" gain="-6" gainUnit="decibels"/>
  </effects>
  <midi>
    <cc number="20"><binding type="effect" level="instrument" position="2" parameter="FX_FILTER_GAIN" translation="linear" translationOutputMin="1" translationOutputMax="2"/></cc>
  </midi>
</DecentSampler>
