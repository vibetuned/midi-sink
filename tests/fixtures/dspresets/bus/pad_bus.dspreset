<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- The looping pad with both effects on: the storm's material for the XRun check. -->
  <groups attack="0.01" decay="0" sustain="1.0" release="0.2" ampVelTrack="0.3">
    <group>
      <sample path="Samples/pad3s.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="8000" loopEnd="23000" loopCrossfade="2000"/>
      <effects><effect type="lowpass" frequency="6000" resonance="0.8"/></effects>
    </group>
  </groups>
  <effects>
    <effect type="reverb" roomSize="0.85" damping="0.4" wetLevel="0.35"/>
    <effect type="delay" delayTime="0.375" feedback="0.4" stereoOffset="0.02" wetLevel="0.25"/>
  </effects>
</DecentSampler>
