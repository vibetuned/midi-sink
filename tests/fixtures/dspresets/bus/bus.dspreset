<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- The bus (step 52): a short constant through the reverb (wet 0.5) and the delay (0.25 s, feedback 0.5, wet 0.5). -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.005" ampVelTrack="0">
    <group>
      <sample path="Samples/k_half.wav" rootNote="60" loNote="0" hiNote="127"/>
    </group>
  </groups>
  <effects>
    <effect type="reverb" roomSize="0.8" damping="0.3" wetLevel="0.5"/>
    <effect type="delay" delayTime="0.25" feedback="0.5" stereoOffset="0.0" wetLevel="0.5"/>
  </effects>
</DecentSampler>
