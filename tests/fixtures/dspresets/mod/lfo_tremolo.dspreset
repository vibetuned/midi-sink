<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 90: a global sine LFO at 2 Hz multiplying the group volume between 0.5 and 1 — the tremolo; two notes share its phase. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group>
      <sample path="Samples/sine220.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
  <modulators>
    <lfo shape="sine" frequency="2">
      <binding type="amp" level="group" groupIndex="0" parameter="AMP_VOLUME" translation="linear" translationOutputMin="0.5" translationOutputMax="1" modBehavior="multiply"/>
    </lfo>
  </modulators>
</DecentSampler>
