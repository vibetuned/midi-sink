<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 90: previousNotes="57" on a sine and legatoInterval="2" on a saw, beside an unconditional sine at −12 dB: the saw appears only two semitones above the previous note. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group>
      <sample path="Samples/sine220.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000" previousNotes="57"/>
      <sample path="Samples/saw110.wav" rootNote="45" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000" legatoInterval="2"/>
      <sample path="Samples/sine220.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000" volume="-12dB"/>
    </group>
  </groups>
</DecentSampler>
