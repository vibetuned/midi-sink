<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 90: trigger="first" on the sine group and trigger="legato" on the saw group: the first note plays the sine alone, an overlapping note the saw alone. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group trigger="first">
      <sample path="Samples/sine220.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
    <group trigger="legato">
      <sample path="Samples/saw110.wav" rootNote="45" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
</DecentSampler>
