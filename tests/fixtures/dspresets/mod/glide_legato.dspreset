<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 90: a monophonic group (polyphony 1) with glideTime 0.2 and glideMode legato: an overlapping note glides from the held one, a separate note does not. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0" polyphony="1" glideTime="0.2" glideMode="legato">
    <group>
      <sample path="Samples/sine220.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
</DecentSampler>
