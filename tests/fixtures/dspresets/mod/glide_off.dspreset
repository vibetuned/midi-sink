<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 90: glideMode off on a monophonic group: the previous note releases, the new one starts at its pitch. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0" polyphony="1" glideTime="0.2" glideMode="off">
    <group>
      <sample path="Samples/sine220.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
</DecentSampler>
