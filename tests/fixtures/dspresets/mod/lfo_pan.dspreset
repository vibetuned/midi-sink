<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 90: a sine LFO at 1 Hz setting PAN −100..100: the note swings between the channels. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group>
      <sample path="Samples/sine220.wav" rootNote="57" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
  <modulators>
    <lfo shape="sine" frequency="1">
      <binding type="amp" level="group" groupIndex="0" parameter="PAN" translation="linear" translationOutputMin="-100" translationOutputMax="100" modBehavior="set"/>
    </lfo>
  </modulators>
</DecentSampler>
