<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.0">
  <!-- Step 90: a bus peak at 1 kHz (Q 1, gain 1) with a global sine LFO at 0.5 Hz setting FX_FILTER_GAIN 1..2 (linear): the 990 Hz harmonic of the saw swings 0..6 dB. -->
  <groups attack="0.0" decay="0" sustain="1.0" release="0.01" ampVelTrack="0">
    <group>
      <sample path="Samples/saw110.wav" rootNote="45" loNote="0" hiNote="127" loopEnabled="true" loopStart="0" loopEnd="16000"/>
    </group>
  </groups>
  <effects>
    <effect type="peak" frequency="1000" Q="1" gain="1"/>
  </effects>
  <modulators>
    <lfo shape="sine" frequency="0.5">
      <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_GAIN" translation="linear" translationOutputMin="1" translationOutputMax="2" modBehavior="set"/>
    </lfo>
  </modulators>
</DecentSampler>
