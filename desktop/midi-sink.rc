// Win32 resource script: the icon Explorer and the taskbar show for
// midi-sink.exe, plus the VERSIONINFO block Properties/SmartScreen/winget
// read. Compiled into the executable only on Windows (see
// desktop/CMakeLists.txt); glfwSetWindowIcon still sets the live window icon
// at runtime from desktop/src/app_icon.h. The .ico is generated by
// tools/gen_icons.py from images/midi-sink.jpg.
//
// IDI_ICON1 (id 1) is the conventional "application icon" id: the Win32
// shell shows the lowest-numbered ICON resource for an executable.
#include <winver.h>

1 ICON "midi-sink.ico"

// Version fields come from the tag through CMake (working rule: no
// hand-edited numbers): SUMI_APP_VERSION is the display string, and
// SUMI_RC_FILEVERSION is its numeric X,Y,Z,0 form (VERSIONINFO requires
// four integers; a dev build reads 0,0,0,0).
#ifndef SUMI_APP_VERSION
#define SUMI_APP_VERSION "0.0.0-dev"
#endif
#ifndef SUMI_RC_FILEVERSION
#define SUMI_RC_FILEVERSION 0,0,0,0
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     SUMI_RC_FILEVERSION
 PRODUCTVERSION  SUMI_RC_FILEVERSION
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vibetuned"
            VALUE "FileDescription",  "midi-sink - suminagashi ink-marbling MPE instrument"
            VALUE "FileVersion",      SUMI_APP_VERSION
            VALUE "InternalName",     "midi-sink"
            VALUE "LegalCopyright",   "Copyright (c) Pedro Fillastre. AGPL-3.0-only."
            VALUE "OriginalFilename", "midi-sink.exe"
            VALUE "ProductName",      "midi-sink"
            VALUE "ProductVersion",   SUMI_APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
