<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- midi-sink.exe application manifest (merged into the linker's embedded
     manifest by CMake; see desktop/CMakeLists.txt). DECISIONS_5 #85: every
     path the app handles is UTF-8 (ImGui's text fields, settings.ini, the
     preset names), and the narrow C runtime calls that open them (fopen,
     std::ofstream, _mkdir, getenv) read them in the process's ANSI code page.
     activeCodePage UTF-8 makes that code page UTF-8 on Windows 10 1903 and
     later; older Windows ignores the key and keeps the legacy behaviour. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
