---
/**
 * Starlight's footer plus the version line: SITE_VERSION is injected by the
 * pages workflow from the newest stable git tag — the release users can
 * install and the build served at /marble/ — so the site can state which
 * release it documents without a hand-edited number anywhere, even though
 * its text follows main (DECISIONS_4 #82). Locally it falls back to
 * `git describe`.
 */
import Default from "@astrojs/starlight/components/Footer.astro";
import { execSync } from "node:child_process";

let version = process.env.SITE_VERSION ?? "";
if (!version) {
  try { version = execSync("git describe --tags --always --dirty", { stdio: ["ignore", "pipe", "ignore"] }).toString().trim(); }
  catch { version = "dev"; }
}
---

<Default><slot /></Default>
<p class="site-version">midi-sink {version} · AGPL-3.0 · <a href="https://github.com/vibetuned/midi-sink">source</a></p>
